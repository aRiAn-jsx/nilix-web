---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { type Lang, L, href } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const fa = lang === 'fa';
const title = fa ? 'تجارت و لجستیک بین‌المللی | نیلیکس' : 'International trade and logistics | nilix';
const description = fa
  ? 'چشم‌انداز پیشنهادی نیلیکس برای تجارت و لجستیک بین‌المللی؛ از استعلام و توافق تجاری تا حمل، اسناد و تحویل.'
  : 'The proposed nilix vision for international trade and logistics, from enquiries and agreements to shipping, documentation and delivery.';
const roles = [
  { icon: 'building', t: { fa: 'تأمین‌کننده', en: 'Supplier' }, d: { fa: 'کارخانه یا شرکت پخش داخلی، عرضه‌کننده کالا', en: 'A manufacturer or domestic distributor offering goods' } },
  { icon: 'handshake', t: { fa: 'تاجر و بازرگان', en: 'Trader' }, d: { fa: 'خرید کالا یا ارائه آن به بازار خارجی', en: 'Purchasing goods or offering them to an overseas market' } },
  { icon: 'truck', t: { fa: 'شرکت حمل', en: 'Carrier' }, d: { fa: 'جابجایی محموله و مدیریت مدارک حمل', en: 'Moving shipments and managing transport documents' } },
  { icon: 'store', t: { fa: 'خریدار مقصد', en: 'Destination buyer' }, d: { fa: 'دریافت کالا و اعلام مغایرت احتمالی', en: 'Receiving goods and reporting any discrepancies' } },
];
const journey = [
  { t: { fa: 'استعلام', en: 'Enquiry' }, d: { fa: 'کالا، مقدار و مقصد مشخص می‌شود.', en: 'Specify the goods, quantity and destination.' } },
  { t: { fa: 'مقایسه پیشنهادها', en: 'Compare offers' }, d: { fa: 'قیمت، ارز و اعتبار پیشنهاد بررسی می‌شود.', en: 'Review price, currency and offer validity.' } },
  { t: { fa: 'توافق تجاری', en: 'Trade agreement' }, d: { fa: 'شرایط پرداخت و محل تحویل روشن می‌شود.', en: 'Agree on payment terms and the delivery location.' } },
  { t: { fa: 'حمل و دریافت', en: 'Ship and receive' }, d: { fa: 'محموله پیگیری و نتیجه دریافت ثبت می‌شود.', en: 'Track the shipment and record receipt.' } },
];
const modes = [
  { icon: 'truck', t: { fa: 'جاده‌ای', en: 'Road' }, d: { fa: 'زمینی و مرزی', en: 'Land and border crossings' } },
  { icon: 'layers', t: { fa: 'ریلی', en: 'Rail' }, d: { fa: 'ظرفیت و برنامه مسیر', en: 'Capacity and route schedules' } },
  { icon: 'ship', t: { fa: 'دریایی', en: 'Sea' }, d: { fa: 'محموله و اسناد حمل', en: 'Cargo and shipping documents' } },
  { icon: 'plane', t: { fa: 'هوایی', en: 'Air' }, d: { fa: 'زمان و شرایط بار', en: 'Timing and cargo requirements' } },
];
const records = [
  { t: { fa: 'توافق کالا', en: 'Goods agreement' }, d: { fa: 'مشخصات، مقدار و بسته‌بندی', en: 'Specifications, quantity and packaging' } },
  { t: { fa: 'شرایط تجاری', en: 'Commercial terms' }, d: { fa: 'قیمت، ارز، پرداخت و تحویل', en: 'Price, currency, payment and delivery' } },
  { t: { fa: 'مدارک مسیر', en: 'Documents' }, d: { fa: 'پیش‌فاکتور و اسناد موردنیاز', en: 'Pro forma invoice and required documents' } },
  { t: { fa: 'ارسال و دریافت', en: 'Shipment and receipt' }, d: { fa: 'پیوند محموله، پرداخت و مانده', en: 'Linked shipments, payments and balances' } },
];
---
<Base lang={lang} title={title} description={description} path="/global" scene="ink">
  <section class="global-hero" data-scene="ink">
    <div class="hero-grid wrap">
      <div class="hero-copy">
        <div class="hero-kicker"><span></span>{fa ? 'چشم‌انداز توسعه بین‌المللی نیلیکس' : 'The nilix international vision'}</div>
        <h1>{fa ? 'تجارت، فراتر از مرزها' : 'Trade beyond borders'}</h1>
        <p>{fa ? 'از اولین استعلام تا مقصد نهایی؛ چشم‌اندازی برای پیوند تجارت، حمل و اسناد در یک مسیر روشن.' : 'From the first enquiry to the final destination: a vision connecting trade, logistics and documents in one clear journey.'}</p>
        <div class="hero-actions">
          <a class="btn hero-primary" href="#vision">{fa ? 'کشف این چشم‌انداز' : 'Explore the vision'} <Icon name="arrow" class="flip" /></a>
          <a class="hero-link" href={href(lang, '/contact')}>{fa ? 'گفت‌وگو با نیلیکس' : 'Talk to nilix'}</a>
        </div>
        <div class="hero-caption"><span class="caption-line"></span>{fa ? 'کالا، سند و وجه؛ در یک مسیر روشن' : 'Goods, documents and payments, connected'}</div>
      </div>
      <div class="hero-art" aria-hidden="true">
        <div class="orbit orbit-outer"></div><div class="orbit orbit-inner"></div>
        <div class="globe-shell">
          <svg class="globe-lines" viewBox="0 0 500 500" fill="none">
            <circle cx="250" cy="250" r="221"/><ellipse cx="250" cy="250" rx="106" ry="221"/><ellipse cx="250" cy="250" rx="190" ry="221"/><ellipse cx="250" cy="250" rx="221" ry="84"/><ellipse cx="250" cy="250" rx="221" ry="163"/><path d="M29 250h442M250 29v442"/>
            <path class="route-shadow" d="M75 300C145 130 278 111 414 206"/><path class="route" d="M75 300C145 130 278 111 414 206"/>
            <circle class="route-dot" cx="75" cy="300" r="6"/><circle class="route-dot" cx="414" cy="206" r="6"/>
          </svg>
          <div class="globe-core"><Icon name="globe" size={45} /><span>nilix</span></div>
        </div>
        <div class="floating-card glass card-trade"><div class="float-icon"><Icon name="box" size={21} /></div><div><small>{fa ? 'تجارت بین‌المللی' : 'International trade'}</small><b>{fa ? 'از استعلام تا توافق' : 'Enquiry to agreement'}</b></div></div>
        <div class="floating-card glass card-shipping"><div class="float-icon"><Icon name="truck" size={21} /></div><div><small>{fa ? 'حمل و لجستیک' : 'Transport & logistics'}</small><b>{fa ? 'در مسیر مقصد' : 'On the way'}</b></div></div>
        <div class="art-index">NILIX / INTERNATIONAL</div>
      </div>
    </div>
  </section>

  <section class="intro-section" id="vision" data-scene="paper">
    <div class="wrap intro-grid">
      <div><span class="section-tag">{fa ? 'یک زنجیره، نقش‌های گسترده‌تر' : 'One connected chain'}</span><h2>{fa ? 'تجارت جهانی، با نگاهی یکپارچه' : 'A connected view of global trade'}</h2></div>
      <div><p>{fa ? 'در طرح پیشنهادی توسعه بین‌المللی نیلیکس، تأمین‌کننده، تاجر، شرکت حمل و خریدار مقصد در یک مسیر به هم می‌رسند. نقش تجاری هر طرف برای هر معامله مشخص می‌شود.' : 'In the proposed international expansion of nilix, suppliers, traders, carriers and destination buyers come together along one journey. Each party’s commercial role is defined for each transaction.'}</p><p class="proposal-note">{fa ? 'آنچه در ادامه می‌بینید، طرح پیشنهادی توسعه است و لزوماً به معنی فعال بودن همه قابلیت‌ها نیست.' : 'The following describes a development proposal; it does not imply that every feature is currently available.'}</p></div>
    </div>
    <div class="wrap roles-grid">{roles.map((item) => <article class="role"><div class="role-icon"><Icon name={item.icon} size={24} /></div><h3>{L(lang, item.t)}</h3><p>{L(lang, item.d)}</p></article>)}</div>
  </section>

  <section class="services-section" data-scene="ink">
    <div class="wrap">
      <div class="section-heading"><span class="section-tag">{fa ? 'دو مسیر مستقل، یک نگاه مشترک' : 'Two independent services'}</span><h2>{fa ? 'تجارت و حمل، کنار هم' : 'Trade and transport, side by side'}</h2><p>{fa ? 'برای هر نیاز، از معامله کالا تا جابه‌جایی بار، مسیری روشن در نظر گرفته شده است.' : 'A clear path for each need, from trading goods to moving cargo.'}</p></div>
      <div class="service-grid">
        <article class="service service-trade"><div class="service-top"><Icon name="globe" size={30} /><span>01</span></div><h3>{fa ? 'تجارت بین‌المللی' : 'International trade'}</h3><p>{fa ? 'ثبت نیاز خرید یا عرضه، مقایسه پیشنهادها و توافق روی شرایط، با تشکیل پرونده‌ای برای معامله.' : 'Register a buying requirement or offer, compare proposals and agree terms with a record for the transaction.'}</p><div class="service-bottom">{fa ? 'استعلام  /  پیشنهاد  /  توافق' : 'Enquiry  /  Offer  /  Agreement'}</div></article>
        <article class="service service-logistics"><div class="service-top"><Icon name="truck" size={30} /><span>02</span></div><h3>{fa ? 'حمل‌ونقل و لجستیک' : 'Transport and logistics'}</h3><p>{fa ? 'ثبت بار، مبدأ و مقصد، مقایسه نرخ و زمان، انتخاب حمل و پیگیری دریافت محموله.' : 'Register cargo, origin and destination, compare rates and timing, choose transport and follow delivery.'}</p><div class="service-bottom">{fa ? 'بار  /  مسیر  /  تحویل' : 'Cargo  /  Route  /  Delivery'}</div></article>
      </div>
      <p class="service-note"><Icon name="sparkle" size={19} />{fa ? 'در طرح پیشنهادی، درخواست حمل وابسته به خرید کالا در پلتفرم نیست.' : 'In the proposal, a transport request does not depend on buying goods on the platform.'}</p>
    </div>
  </section>

  <section class="journey-section" data-scene="paper">
    <div class="wrap"><div class="section-heading dark-heading"><span class="section-tag">{fa ? 'مسیر معامله' : 'The transaction journey'}</span><h2>{fa ? 'از استعلام تا تحویل' : 'From enquiry to delivery'}</h2><p>{fa ? 'پیش از اجرا، ارز، شرایط تحویل و مسئولیت هر طرف باید روشن شود.' : 'Before execution, currency, delivery terms and each party’s responsibilities need to be clear.'}</p></div>
      <div class="journey-grid">{journey.map((step, i) => <article class="journey-step"><span class="step-number">{String(i + 1).padStart(2, '0')}</span><h3>{L(lang, step.t)}</h3><p>{L(lang, step.d)}</p></article>)}</div>
    </div>
  </section>

  <section class="record-section" data-scene="ink">
    <div class="wrap record-grid"><div class="record-copy"><span class="section-tag">{fa ? 'پرونده معامله' : 'The transaction record'}</span><h2>{fa ? 'یک معامله؛ یک تصویر منسجم' : 'One transaction, one connected record'}</h2><p>{fa ? 'در این طرح، جزئیات کالا، توافق‌ها، مدارک و وضعیت ارسال در کنار هم قرار می‌گیرند تا ارتباط میان کالا، محموله و پرداخت روشن‌تر باشد.' : 'The proposal brings goods details, agreements, documents and shipment status together, making the relationship between cargo and payments clearer.'}</p><div class="record-mark"><Icon name="file" size={30} /><span>{fa ? 'از توافق تا دریافت' : 'From agreement to receipt'}</span></div></div>
      <div class="record-list">{records.map((item) => <div class="record-row"><span class="record-check"><Icon name="shield" size={20} /></span><div><h3>{L(lang, item.t)}</h3><p>{L(lang, item.d)}</p></div></div>)}</div>
    </div>
  </section>

  <section class="transport-section" data-scene="paper"><div class="wrap"><div class="section-heading dark-heading"><span class="section-tag">{fa ? 'لجستیک بین‌المللی' : 'International logistics'}</span><h2>{fa ? 'یک معامله، مسیرهای گوناگون' : 'One transaction, multiple routes'}</h2><p>{fa ? 'در حمل ترکیبی، مسئول و وضعیت هر مرحله جداگانه ثبت می‌شود؛ حتی وقتی یک معامله چند محموله داشته باشد.' : 'For multimodal transport, each leg has its own responsible party and status, even when a transaction has multiple shipments.'}</p></div><div class="mode-grid">{modes.map((mode) => <article class="mode"><Icon name={mode.icon} size={31} /><h3>{L(lang, mode.t)}</h3><p>{L(lang, mode.d)}</p></article>)}</div>
    <div class="transport-detail"><div><h3>{fa ? 'برای صاحب کالا' : 'For cargo owners'}</h3><p>{fa ? 'ثبت مشخصات بار و مسیر، مقایسه نرخ و زمان پیشنهادی و پیگیری دریافت.' : 'Register cargo and route details, compare proposed rates and times, and follow delivery.'}</p></div><div><h3>{fa ? 'برای شرکت حمل' : 'For carriers'}</h3><p>{fa ? 'اعلام ظرفیت و نرخ مسیر، پذیرش سفارش، تخصیص وسیله و ثبت اسناد و وضعیت محموله.' : 'Offer capacity and route rates, accept orders, assign vehicles and record documents and shipment status.'}</p></div></div>
  </div></section>

  <section class="assurance-section" data-scene="ink"><div class="wrap"><div class="section-heading"><span class="section-tag">{fa ? 'شفافیت در هر مرحله' : 'Clarity at each step'}</span><h2>{fa ? 'فراتر از جابه‌جایی کالا' : 'More than moving goods'}</h2></div><div class="assurance-grid"><article><Icon name="wallet" size={28} /><h3>{fa ? 'حساب و تسویه' : 'Accounts and settlement'}</h3><p>{fa ? 'پیوند پرداخت‌ها به پرونده تجاری، ثبت کرایه و مسئول پرداخت، و مقایسه مانده با توافق.' : 'Link payments to the transaction, record freight costs and the responsible payer, and compare balances with the agreement.'}</p></article><article><Icon name="shield" size={28} /><h3>{fa ? 'بیمه و مدیریت ریسک' : 'Insurance and risk'}</h3><p>{fa ? 'پیش‌بینی ثبت بیمه‌نامه و اعتبار آن، اتصال به محموله و رسیدگی به خسارت طبق شرایط پوشش.' : 'The proposal includes recording policy details and validity, linking cover to cargo and handling claims under its terms.'}</p></article><article><Icon name="globe" size={28} /><h3>{fa ? 'ارتباط در دو سوی مرز' : 'Communication across borders'}</h3><p>{fa ? 'در چشم‌انداز طرح، رابط فارسی، پشتو و انگلیسی با نمایش روشن مبلغ، ارز و واحد در نظر گرفته شده است.' : 'The vision includes Persian, Pashto and English interfaces, with clear amounts, currencies and units.'}</p></article></div></div></section>

  <section class="terms-section" data-scene="paper"><div class="wrap terms-inner"><div><span class="section-tag">Incoterms® 2020</span><h2>{fa ? 'شرایط تحویل، روشن و استاندارد' : 'Clear, standard delivery terms'}</h2><p>{fa ? 'اینکوترمز به طرفین کمک می‌کند درباره هزینه‌ها، مسئولیت‌ها و نقطه انتقال ریسک حمل به توافق روشن‌تری برسند.' : 'Incoterms help the parties clarify costs, responsibilities and where transport risk transfers.'}</p>{fa && <a href="/blog/incoterms-for-exporters">آشنایی با اینکوترمز</a>}</div><div class="terms-list" dir="ltr" aria-label="Incoterms 2020"><span>EXW</span><span>FCA</span><span>FOB</span><span>CFR</span><span>CIF</span><span>CPT</span><span>CIP</span><span>DAP</span><span>DDP</span></div></div></section>

  <section class="pilot-section" data-scene="red"><div class="wrap pilot-inner"><div><span class="section-tag">{fa ? 'پایلوت پیشنهادی' : 'Proposed pilot'}</span><h2>{fa ? 'شروعی متمرکز؛ از ایران به افغانستان' : 'A focused start: Iran to Afghanistan'}</h2><p>{fa ? 'آزمایش با یک کارخانه، یک قلم کالا و یک مقصد مشخص؛ از توافق بر سر کالا تا هماهنگی حمل، تحویل و تسویه.' : 'A pilot with one factory, one product and one destination, from agreement on the goods to transport, delivery and settlement.'}</p><small>{fa ? 'پیش‌نیاز: بررسی مقررات، گمرک، پرداخت قانونی و مجوز طرفین.' : 'Prerequisites: review regulations, customs, lawful payment and the parties’ permits.'}</small></div><a class="btn pilot-button" href={href(lang, '/contact')}>{fa ? 'درباره همکاری صحبت کنیم' : 'Discuss a collaboration'} <Icon name="arrow" class="flip" /></a></div></section>
  <CtaBand lang={lang} />
</Base>

<style>
  .global-hero { position: relative; overflow: hidden; background: #070709; color: #fff; isolation: isolate; }
  .global-hero::before { content: ''; position: absolute; width: 55vw; height: 55vw; min-width: 560px; min-height: 560px; left: -16%; top: -20%; border-radius: 50%; background: #9b071b; filter: blur(120px); opacity: .33; z-index: -1; }
  .global-hero::after { content: ''; position: absolute; inset: 0; z-index: -1; opacity: .13; background-image: linear-gradient(rgba(255,255,255,.12) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.12) 1px, transparent 1px); background-size: 90px 90px; mask-image: linear-gradient(to bottom, transparent, #000 35%, transparent); }
  .hero-grid { min-height: min(820px, 100svh); padding-top: 130px; padding-bottom: 90px; display: grid; grid-template-columns: 1fr 1.05fr; align-items: center; gap: 30px; }
  .hero-copy { position: relative; z-index: 2; }
  .hero-kicker, .section-tag { display: inline-flex; align-items: center; gap: 10px; font-size: .86rem; font-weight: 750; }
  .hero-kicker { color: #f2adb7; }
  .hero-kicker span { width: 9px; height: 9px; border-radius: 50%; background: #ef1835; box-shadow: 0 0 18px #e91c37; }
  .hero-copy h1 { max-width: 9ch; font-size: clamp(3.1rem, 6.2vw, 6.5rem); line-height: 1.25; letter-spacing: -.045em; margin: 25px 0; }
  .hero-copy > p { max-width: 43ch; color: #c7bec2; font-size: clamp(1.05rem, 1.55vw, 1.3rem); line-height: 2; margin: 0; }
  .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 25px; margin-top: 34px; }
  .hero-primary { --b-bg: #d0051f; --b-fg: #fff; min-height: 58px; }
  .hero-link { text-underline-offset: 7px; font-weight: 700; font-size: .95rem; }
  .hero-caption { margin-top: 70px; display: flex; align-items: center; gap: 14px; color: #afa1a5; font-size: .82rem; }
  .caption-line { width: 42px; height: 1px; background: #d0051f; }
  .hero-art { position: relative; width: 100%; aspect-ratio: 1; display: grid; place-items: center; direction: ltr; }
  .orbit { position: absolute; border: 1px solid rgba(255,255,255,.1); border-radius: 50%; }
  .orbit-outer { inset: 1%; }.orbit-inner { inset: 10%; border-style: dashed; }
  .globe-shell { position: absolute; inset: 10%; border-radius: 50%; display: grid; place-items: center; background: radial-gradient(circle at 35% 25%, rgba(255,105,120,.30), rgba(167,0,26,.22) 38%, rgba(35,4,12,.55) 72%); box-shadow: inset 0 0 55px rgba(255,255,255,.08), 0 0 90px rgba(208,5,31,.22); border: 1px solid rgba(255,255,255,.2); }
  .globe-lines { position: absolute; inset: 0; width: 100%; height: 100%; stroke: rgba(255,255,255,.19); stroke-width: 1; }
  .globe-lines .route-shadow { stroke: #ed1839; stroke-width: 11; opacity: .24; filter: blur(6px); }.globe-lines .route { stroke: #fff; stroke-width: 2.5; stroke-dasharray: 6 8; }.globe-lines .route-dot { fill: #fff; stroke: #ff405a; stroke-width: 5; }
  .globe-core { width: 110px; height: 110px; border-radius: 35px; display: grid; place-content: center; justify-items: center; gap: 3px; color: white; background: rgba(208,5,31,.7); border: 1px solid rgba(255,255,255,.4); box-shadow: inset 1px 1px 12px rgba(255,255,255,.23), 0 20px 50px rgba(0,0,0,.35); backdrop-filter: blur(18px); font-size: 1.05rem; font-weight: 800; }
  .floating-card { position: absolute; display: flex; align-items: center; gap: 12px; padding: 13px 16px; border-radius: 19px; background: rgba(28,21,26,.64); border: 1px solid rgba(255,255,255,.14); direction: inherit; }
  .floating-card small, .floating-card b { display: block; white-space: nowrap; }.floating-card small { color: #c3b5ba; font-size: .69rem; }.floating-card b { font-size: .82rem; }.float-icon { background: rgba(208,5,31,.3); color: #ff7a8c; width: 42px; height: 42px; display: grid; place-items: center; border-radius: 13px; }
  .card-trade { top: 20%; right: 0; }.card-shipping { bottom: 19%; left: 0; }.art-index { position: absolute; bottom: 3%; color: #a69298; font-size: .65rem; letter-spacing: .18em; }
  .intro-section, .journey-section, .transport-section { background: #f3f0ec; color: #171317; }.services-section, .record-section, .assurance-section { background: #0b0a0d; color: #f8f4f4; }.intro-section, .services-section, .journey-section, .record-section, .transport-section, .assurance-section { padding: clamp(80px, 9vw, 140px) 0; }
  .section-tag { color: #d0051f; }.intro-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8%; align-items: start; }.intro-grid h2, .section-heading h2, .record-copy h2, .pilot-inner h2 { font-size: clamp(2.1rem, 4.2vw, 4rem); line-height: 1.35; margin-top: 17px; letter-spacing: -.035em; }.intro-grid p, .record-copy > p, .pilot-inner p { font-size: 1.08rem; line-height: 2; margin: 0; }.intro-grid .proposal-note { font-size: .86rem; margin-top: 20px; color: #71666d; border-inline-start: 2px solid #d0051f; padding-inline-start: 15px; }
  .roles-grid { margin-top: 65px; display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid #d6cdd0; }.role { padding: 30px 0 0 20px; }.role-icon { color: #d0051f; margin-bottom: 25px; }.role h3, .mode h3, .assurance-grid h3 { font-size: 1.25rem; }.role p, .mode p, .journey-step p { color: #6d6469; font-size: .93rem; max-width: 28ch; }
