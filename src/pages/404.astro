---
import Base from '../layouts/Base.astro';
---
<Base lang="fa" title="صفحه پیدا نشد" description="این صفحه وجود ندارد." path="/404" noindex alternates={{ fa: null, en: null }}>
  <section class="page-hero blend" data-scene="ink" style="min-height:80vh;text-align:center">
    <div class="glow" style="inset-inline-start:30%;top:-30vmax"></div>
    <div class="wrap" style="display:grid;justify-items:center;gap:20px">
      <p class="display grad" style="font-size:clamp(6rem,20vw,14rem);margin:0;line-height:1">۴۰۴</p>
      <h1 class="h2">این صفحه پیدا نشد</h1>
      <p class="lead" lang="en" dir="ltr">This page could not be found.</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap;justify-content:center">
        <a class="btn" href="/">صفحه‌ی اصلی</a>
        <a class="btn btn-ghost" href="/en" lang="en">English home</a>
      </div>
    </div>
  </section>
</Base>
