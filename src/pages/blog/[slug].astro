---
import BlogPost from '../../views/BlogPost.astro';
import { posts, slugOf, type Post } from '../../lib/blog';

export async function getStaticPaths() {
  return (await posts('fa')).map((post) => ({ params: { slug: slugOf(post) }, props: { post } }));
}
const { post } = Astro.props as { post: Post };
---
<BlogPost post={post} />
